#include <windows.h>
IDI_ICON1 ICON "@PAPERCUT_ICO@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PAPERCUT_FILEVERSION@
PRODUCTVERSION @PAPERCUT_FILEVERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Papercut"
            VALUE "FileVersion", "@PAPERCUT_VERSION_STR@"
            VALUE "InternalName", "papercut"
            VALUE "OriginalFilename", "papercut.exe"
            VALUE "ProductName", "Papercut"
            VALUE "ProductVersion", "@PAPERCUT_VERSION_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
